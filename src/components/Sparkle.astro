---
/**
 * A twinkling star-like glow (decoration only). Place it with a class, e.g.
 * <Sparkle size={34} class="my-spot" delay={1.2} />. Color: --sp (default warm gold).
 */
const { size = 32, class: cls = '', style = '', delay = 0 } = Astro.props;
---

<svg
  class:list={['sparkle', cls]}
  viewBox="0 0 40 40"
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  style={`${style}; animation-delay: ${delay}s`}
>
  <path d="M20 0c1.3 11 4.2 16.7 20 20-15.8 3.3-18.7 9-20 20-1.3-11-4.2-16.7-20-20C15.8 16.7 18.7 11 20 0z"></path>
  <circle cx="20" cy="20" r="3.2"></circle>
</svg>
